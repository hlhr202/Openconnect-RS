{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openconnect-gui",
  "version": "0.2.0",
  "identifier": "com.openconnect-gui.rs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "openconnect-gui",
        "width": 900,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "vpnc-script",
      "vpnc-script-win.js",
      "wintun.dll",
      "WebView2Loader.dll",
      "icons/connected-w.png",
      "icons/disconnected-w.png"
    ]
  }
}
